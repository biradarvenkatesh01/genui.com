# Model provider for /api/generate. Set one key; Groq wins if both are set.
# Leave both unset to run in demo mode (bundled sample components, no API calls).

# Groq — fastest (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: override the model (defaults to openai/gpt-oss-120b).
GROQ_MODEL=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the model (defaults to gemini-flash-latest).
GEMINI_MODEL=
